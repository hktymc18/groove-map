rules_version = '2';
// =====================================================================
// GROOVE 共通 Firestore セキュリティルール（MAP / AttackList / 目標シート）
// ---------------------------------------------------------------------
// ⚠️ 公開順序の注意:
//   このルールは「新規プロフィール作成時に union/area/upRuby/upBd が必須」。
//   3アプリの登録フォームがこの4項目を送るように改修してから公開すること。
//   先に公開すると新規登録が一切できなくなります。
//
// 設計:
//   - users/{uid} = 3アプリ共通プロフィール（union/area/upRuby/upBd/role/status）
//   - オーナーUIDは固定で「永久管理者」。role=='admin' で共同管理者を動的に付与。
//   - status=='disabled' で当該ユーザーは自分のデータを読み書き不可（管理者が設定）。
//   - v786: 受付の名簿と紐付けた人は、名簿で「無効」にした時も同じく読み書き不可（rosterOff）。
//   - 既存(レガシー)プロフィールは status 未設定 → 「無効化されていない」扱いでロックしない。
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail()  { return request.auth.token.email; }
    function isSelf(uid){ return signedIn() && request.auth.uid == uid; }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }
    function profile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // オーナー（固定・永久）。v669: 馬越さんを追加（app.js の OWNER_UIDS・checkin の OWNER_UIDS と一致させること）
    function isOwnerUid() {
      return signedIn() && request.auth.uid in ['j2DPDAccCygHmR9i5K3bTvHnH0V2', 'E4WT7EHai5c6WANUgASz42Euu1y1'];
    }
    // オーナー(固定・永久) または role=='admin' を付与された共同管理者
    function isAdmin() {
      return signedIn() && (
        isOwnerUid() ||
        (profileExists(request.auth.uid) && profile(request.auth.uid).get('role','') == 'admin')
      );
    }

    // 無効化されていない（status!='disabled'）。承認待ち(pending)・レガシー(status無し)は通過。
    // ※承認制のMAPアクセス制御はクライアント側(loginSuccessの承認待ちゲート)で実施。
    //   個人アプリ(GOAL SETTING / ATTACK LIST)は登録直後(pending)から使える。
    function notDisabled(uid) {
      return profileExists(uid) && profile(uid).get('status','active') != 'disabled' && !rosterOff(uid);
    }
    // 🔗 v786: 受付（BASE CHECK-IN）の名簿で「無効」にした人は、データも読み書きできない（無効化と同じ扱い）
    //   対象＝アカウント管理で名簿と紐付けた人（users/{uid}.ckNo）。オーナー・管理者は対象外（アプリの画面の判定と同じ）
    function rosterOff(uid) {
      let pf = profile(uid);
      let no = pf.get('ckNo', '');
      return no is string && no != ''
        && !(uid in ['j2DPDAccCygHmR9i5K3bTvHnH0V2', 'E4WT7EHai5c6WANUgASz42Euu1y1'])
        && pf.get('role', '') != 'admin'
        && exists(/databases/$(database)/documents/checkinMembers/$(no))
        && get(/databases/$(database)/documents/checkinMembers/$(no)).data.get('active', true) == false;
    }
    // 自分が有効なオーナー
    function ownerActive(uid) { return isSelf(uid) && notDisabled(uid); }

    // 承認制ヘルパー
    function isOwnerAdmin() {
      return isOwnerUid();
    }
    function isUnionAdmin() {
      return signedIn() && profileExists(request.auth.uid) && profile(request.auth.uid).get('role','') == 'admin';
    }
    // v831: 兼務のユニオン管理者（オーナーが checkinUnions/{un}.coreAdmins に指定・受付システムと共通の設定）
    function isCoreAdminOf(un) {
      return signedIn() && un is string && un != '' && notDisabled(request.auth.uid)
        && exists(/databases/$(database)/documents/checkinUnions/$(un))
        && get(/databases/$(database)/documents/checkinUnions/$(un)).data.get('coreAdmins', []).hasAny([request.auth.uid]);
    }
    // v831: そのユニオンの管理者＝（管理者の印があって、所属がそのユニオン）または兼務の管理者
    function admOf(un) {
      return (isUnionAdmin() && un is string && un != '' && profile(request.auth.uid).get('union', '__a') == un)
        || isCoreAdminOf(un);
    }
    // 更新対象(resource)が自分と同じユニオン
    function sameUnionAsTarget() {
      return profileExists(request.auth.uid)
          && profile(request.auth.uid).get('union','__a') == resource.data.get('union','__b');
    }

    // 新規プロフィールの必須項目
    function hasRequiredProfile(d) {
      return d.union  is string && d.union.size()  > 0
          && d.area   is string && d.area.size()   > 0
          && d.upRuby is string && d.upRuby.size() > 0
          && d.upBd   is string && d.upBd.size()   > 0;
    }

    // ============ プロフィール（3アプリ共通） ============
    match /users/{uid} {
      // 共有・ユーザー検索のため、ログイン済みは閲覧可
      allow read: if signedIn();

      // 新規登録：本人のみ＆必須4項目＆role=member＆自分で active にできない
      // （status 未設定=GOAL/ATTACK も可、pending=MAP も可。active だけ禁止＝自己承認防止）
      allow create: if isSelf(uid)
        && hasRequiredProfile(request.resource.data)
        && (!('role'   in request.resource.data) || request.resource.data.role   == 'member')
        && request.resource.data.get('status','pending') != 'active'
        && !('ckNo' in request.resource.data)
        && !('early' in request.resource.data)
        && !('alLeader' in request.resource.data);

      // 更新：オーナーは全員／ユニオンリーダーは同ユニオンのみ（承認・無効化・役割付与）。
      //       本人は role/status/ckNo（受付の名簿との紐付け）/early（先行利用）を変えない範囲のみ可。
      // v831: ユニオンの管理者は、管理しているユニオン（所属・兼務）の人だけ。管理していないユニオンへは移せない
      allow update: if isOwnerAdmin()
        || (admOf(resource.data.get('union', '')) && admOf(request.resource.data.get('union', '')))
        || (isSelf(uid)
            && request.resource.data.get('role','member')   == resource.data.get('role','member')
            && request.resource.data.get('status','active') == resource.data.get('status','active')
            && request.resource.data.get('ckNo','')         == resource.data.get('ckNo','')
            && request.resource.data.get('early', false)    == resource.data.get('early', false) // v790: 先行利用は本人が変えられない
            && request.resource.data.get('alLeader', false) == resource.data.get('alLeader', false) // ATTACK LIST のリーダー指定は本人が変えられない
            // v831: 管理者は自分の所属ユニオンを変えられない（変えると別のユニオンの管理者になれてしまうため。オーナーに頼む）
            && (resource.data.get('role', 'member') != 'admin'
                || resource.data.get('unionSelectedV2', false) != true
                || request.resource.data.get('union', '') == resource.data.get('union', '')))
        || alLeaderOut()
        || ckLinkByCk();

      // 🎫 v33: 受付で無効にする時、受付の管理者（ユニオン管理者・受付管理者）がその場でNAVIGATORのアカウントを名簿と紐付けられる
      //   ・まだ紐付いていないアカウントだけ（付け替え・解除はNAVIGATORのアカウント管理で）
      //   ・名簿の人とアカウントが同じユニオンで、そのユニオンの受付の管理者であること
      function ckLinkByCk() {
        return signedIn() && notDisabled(request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ckNo', 'ckSetBy', 'ckSetAt'])
            && resource.data.get('ckNo', '') == ''
            && request.resource.data.get('ckSetBy', '') == request.auth.uid
            && request.resource.data.get('ckNo', '') is string && request.resource.data.get('ckNo', '') != ''
            && exists(/databases/$(database)/documents/checkinMembers/$(request.resource.data.ckNo))
            && get(/databases/$(database)/documents/checkinMembers/$(request.resource.data.ckNo)).data.get('union', '') == resource.data.get('union', '')
            && isCkAdmin(resource.data.get('union', ''));
      }

      // ATTACK LIST のリーダー（オーナー／ユニオン管理者が users/{uid}.alLeader=true にした人）は、
      // 自分にリストを共有しているメンバーに限り、利用停止（OUT）とその解除ができる。
      //   ・変えられるのは status / outPrev（停止前の状態）/ disabledAt / disabledBy だけ
      //   ・停止するとき: outPrev に今の status を控える
      //   ・解除するとき: status は outPrev に戻すだけ（承認待ちの人を勝手に承認済みにはできない）
      //   ・オーナーと管理者は対象外
      function alLeaderOut() {
        return signedIn() && request.auth.uid != uid
            && !(uid in ['j2DPDAccCygHmR9i5K3bTvHnH0V2', 'E4WT7EHai5c6WANUgASz42Euu1y1']) // オーナー2人とも対象外（isOwnerUid と同じ一覧）
            && resource.data.get('role', 'member') != 'admin'
            && profileExists(request.auth.uid)
            && profile(request.auth.uid).get('alLeader', false) == true
            && profile(request.auth.uid).get('status', 'active') != 'disabled'
            && exists(/databases/$(database)/documents/users/$(uid)/alShares/$(request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'outPrev', 'disabledAt', 'disabledBy'])
            && ( ( request.resource.data.get('status', '') == 'disabled'
                   && resource.data.get('status', 'active') != 'disabled'
                   && request.resource.data.get('outPrev', '') == resource.data.get('status', 'active') )
              || ( resource.data.get('status', '') == 'disabled'
                   && request.resource.data.get('status', '') == resource.data.get('outPrev', 'active') ) );
      }

      // v777: 削除はオーナー／同じユニオンの管理者だけ（前はどのユニオンの管理者でも消せた）。v831: 兼務のユニオンも
      allow delete: if isOwnerAdmin() || admOf(resource.data.get('union', ''));

      // ---- AttackList：人物リスト ----
      // v586: 本人と、本人が共有した人だけ（管理者も読めない）
      // 共有された人（読む側）が無効化されたら読めない（退会者の持ち出し防止）。
      // リストの持ち主が無効化（OUT）されても、共有を受けていた側は引き続き読める（辞めた人のリストをチームに残すため）。
      //   新方式: users/{uid}/alShares/{相手uid} があること
      //   旧方式: settings/share の sharedWith に相手のメールアドレスがあること（新方式へ移行するまでの経過措置）
      match /people/{pid} {
        function alSharedToMe() {
          return signedIn() && notDisabled(request.auth.uid)
              && ( exists(/databases/$(database)/documents/users/$(uid)/alShares/$(request.auth.uid))
                   || ( exists(/databases/$(database)/documents/users/$(uid)/settings/share)
                        && get(/databases/$(database)/documents/users/$(uid)/settings/share)
                             .data.get('sharedWith', []).hasAny([myEmail()]) ) );
        }
        allow read:  if ownerActive(uid) || alSharedToMe();
        allow write: if ownerActive(uid);
        // 共有された人が変えられるのはステータスだけ
        allow update: if alSharedToMe()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      }
      // ---- AttackList：Family DATA（家族の情報。1人1つ＝family/main） ----
      // 本人が読み書きする。リストを共有している相手（alShares）のうち、本人が viewers（見せる人の uid 一覧）に入れた人だけ読める。
      // 共有された相手が書けるのは「Uラインからのアドバイス」（advice / adviceAt）だけ。
      // 持ち主が OUT されても、共有を受けていた側は人物リストと同じく引き続き読める。
      match /family/{fid} {
        function famSharedToMe() {
          return signedIn() && request.auth.uid != uid && notDisabled(request.auth.uid)
              && exists(/databases/$(database)/documents/users/$(uid)/alShares/$(request.auth.uid))
              && resource.data.get('viewers', []).hasAny([request.auth.uid]);
        }
        allow read:  if ownerActive(uid) || famSharedToMe();
        allow write: if ownerActive(uid);
        allow update: if famSharedToMe()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['advice', 'adviceAt'])
          && request.resource.data.advice is map;
      }
      // ---- AttackList：共有設定（旧方式のメールアドレス一覧など）。本人だけが読める ----
      // 以前はログイン済みなら誰でも読めた（全員の共有相手のメールアドレスが見えていた）ため本人のみに変更。
      // 上の people の判定はルール内の get() で読むので、ここを閉じても共有は切れない。
      match /settings/{sid} {
        allow read:  if isSelf(uid);
        allow write: if ownerActive(uid);
      }
      // ---- AttackList：共有している相手（新方式。本人と、その相手の2人だけが読める） ----
      // 作成: 本人（旧方式からの移行用）／相手が有効な共有コードを添えて自分の分を作る
      // 削除: 本人（共有の解除）／相手（自分から外れる）
      match /alShares/{rid} {
        allow read:   if isSelf(uid) || isSelf(rid);
        allow create: if (ownerActive(uid) && rid != uid)
          || ( isSelf(rid) && rid != uid && notDisabled(rid)
               && request.resource.data.get('code', '') is string
               && request.resource.data.get('code', '').size() >= 8
               && exists(/databases/$(database)/documents/alShareCodes/$(request.resource.data.get('code', '__none')))
               && get(/databases/$(database)/documents/alShareCodes/$(request.resource.data.get('code', '__none'))).data.owner == uid
               && get(/databases/$(database)/documents/alShareCodes/$(request.resource.data.get('code', '__none'))).data.exp > request.time.toMillis() );
        allow delete: if isSelf(uid) || isSelf(rid);
      }
      // ---- v668: 個人情報保護方針・利用規約の同意の履歴（追記のみ。書き換え・削除は不可） ----
      match /consents/{ver} {
        // v777: 同意の履歴を見られるのは本人・オーナー・同じユニオンの管理者だけ
        allow read:   if isSelf(uid) || isOwnerAdmin() || (profileExists(uid) && admOf(profile(uid).get('union', ''))); // v831: 兼務のユニオンも
        allow create: if isSelf(uid);
      }
      // ---- 目標シート（v586: 本人だけ） ----
      match /appData/{aid} {
        allow read:  if ownerActive(uid);
        allow write: if ownerActive(uid);
      }
    }

    // ============ v790: 公開範囲（先行利用 → ユニオン単位 → 全国公開） ============
    //   appAccess/mode  … ログインした人は読める（使えるかの判定）。変えられるのはオーナーだけ
    //   appAccess/names … 前からある登録待ちの名簿（ユニオンの区別なし）。v831: オーナーだけ
    match /appAccess/{doc} {
      allow read:  if (doc == 'mode' && signedIn()) || isOwnerAdmin();
      allow write: if (doc == 'mode' && isOwnerAdmin()) || (doc == 'names' && isOwnerAdmin());
    }
    //   v831: accNames/{ユニオン} … 登録待ちの名簿をユニオンごとに。オーナーとそのユニオンの管理者（所属・兼務）だけ
    match /accNames/{un} {
      allow read, write: if isOwnerAdmin() || admOf(un);
    }

    // ============ v838: ユニオンとUPBD（登録・プロフィールで所属ユニオンを選ぶと入るUPBD） ============
    //   appConfig/unions = { list:[{name, upbd}], at, by }。新規登録の画面（ログイン前）でも使うので読みはだれでも。
    //   変えられるのはオーナーだけ
    //   v847: appConfig/features = { flags:{ 機能名:{ on, testers:[uid] } }, at, by }（新機能のテスト）。
    //   読みはログインした人（自分に出すかを決めるため）・変えられるのはオーナーだけ
    match /appConfig/{doc} {
      allow read: if doc == 'unions' || (doc == 'features' && signedIn());
      allow write: if doc == 'unions' && isOwnerAdmin()
        && request.resource.data.keys().hasOnly(['list', 'at', 'by'])
        && request.resource.data.list is list
        && request.resource.data.list.size() <= 100;
      allow write: if doc == 'features' && isOwnerAdmin()
        && request.resource.data.keys().hasOnly(['flags', 'at', 'by'])
        && request.resource.data.flags is map
        && request.resource.data.flags.size() <= 50;
    }

    // ============ v827: MAPの共有はアップだけ（#23） ============
    //   appShare/top … 共有してよい上の人（uids）。ログインした人は読める。変えられるのはオーナーだけ
    match /appShare/{doc} {
      allow read:  if signedIn();
      allow write: if doc == 'top' && isOwnerAdmin()
        && request.resource.data.keys().hasOnly(['uids', 'at', 'by'])
        && request.resource.data.uids is list;
    }
    //   shareAudit/{共有した人}_{相手} … アップと確認できない人へのMAPの共有の記録。
    //   書けるのは共有した本人（自分の分だけ）。見られるのはオーナーと本人。消せるのはオーナーと本人
    match /shareAudit/{aid} {
      allow read: if isOwnerAdmin() || (signedIn() && resource.data.fromUid == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'fromUnion', 'toUid', 'toName', 'toEmail', 'rel', 'how', 'perm', 'at'])
        && request.resource.data.fromUid == request.auth.uid
        && aid == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.rel in ['down', 'unknown']
        && request.resource.data.how in ['confirm', 'old']
        && request.resource.data.perm in ['view', 'edit'];
      allow delete: if isOwnerAdmin() || (signedIn() && aid.matches(request.auth.uid + '_.*'));
    }

    // ============ MAP本体（months/stats/events/meta/shared） ============
    // 自分宛ての共有ドキュメント
    function myShareDoc(uid) {
      return get(/databases/$(database)/documents/maps/$(uid)/shared/$(request.auth.uid)).data;
    }
    // 共有された相手（閲覧以上）：maps/{uid}/shared/{自分} が存在する
    // v355 連鎖共有: 結合経由の派生共有(derived)は「経由元(via)の共有が生きている間」のみ有効。
    //   （下位が経由元への共有を解除すると、連鎖先も自動的に読めなくなる）
    function isSharedToMap(uid) {
      // 相手（読む側）が無効化されていたら、共有されていたMAPも読めない（退会者の持ち出し防止）
      return signedIn() && notDisabled(uid) && notDisabled(request.auth.uid)
          && exists(/databases/$(database)/documents/maps/$(uid)/shared/$(request.auth.uid))
          && ( myShareDoc(uid).get('derived', false) != true
               || exists(/databases/$(database)/documents/maps/$(uid)/shared/$(myShareDoc(uid).get('via', '__none'))) );
    }
    // 共有編集者：上記に加え perm=='edit'（＝共同編集）。派生共有は常に閲覧のみ。
    function canEditMap(uid) {
      return signedIn() && notDisabled(uid) && notDisabled(request.auth.uid)
          && exists(/databases/$(database)/documents/maps/$(uid)/shared/$(request.auth.uid))
          && myShareDoc(uid).get('derived', false) != true
          && myShareDoc(uid).get('perm', 'view') == 'edit';
    }

    // v533: 予定・タスクを見せる共有か（scope=='map'＝MAPのみ共有／結合経由の自動配布も予定は見せない）
    function canSeeSchedule(uid) {
      return isSharedToMap(uid)
          && myShareDoc(uid).get('derived', false) != true
          && myShareDoc(uid).get('scope', 'all') != 'map';
    }

    // データ本体：read=本人/共有された人、write=本人/共有編集者
    // v586: 管理者（オーナー・ユニオン管理者）でも、共有されていないMAP・予定・データは読み書きできない
    match /maps/{uid}/months/{doc} {
      allow read:  if ownerActive(uid) || isSharedToMap(uid);
      allow write: if ownerActive(uid) || canEditMap(uid);
    }
    match /maps/{uid}/stats/{doc} {
      allow read:  if ownerActive(uid) || isSharedToMap(uid);
      allow write: if ownerActive(uid) || canEditMap(uid);
    }
    match /maps/{uid}/events/{doc} {
      allow read:  if ownerActive(uid) || canSeeSchedule(uid);
      allow write: if ownerActive(uid) || (canEditMap(uid) && canSeeSchedule(uid));
    }
    match /maps/{uid}/meta/{doc} {
      allow read:  if ownerActive(uid) || isSharedToMap(uid);
      allow write: if ownerActive(uid) || canEditMap(uid);
    }
    // 共有設定サブコレクション：作成・変更は本人のみ（共有編集者でも変更不可。v586: 管理者も不可）
    // v355 連鎖共有: このMAPの共有を受けている人は、自分の共有相手向けに
    //   「閲覧専用の派生共有(derived:true, via:自分)」を作成・削除できる。
    //   既存の直接共有ドキュメントは上書き不可（derived==true のものだけ更新可）＝権限の格下げ防止。
    match /maps/{uid}/shared/{rid} {
      allow read:  if ownerActive(uid) || isSelf(rid);
      allow create, update: if ownerActive(uid)
        || ( signedIn() && notDisabled(request.auth.uid)
             && request.resource.data.get('derived', false) == true
             && request.resource.data.get('via', '') == request.auth.uid
             && request.resource.data.get('perm', 'view') == 'view'
             && rid != request.auth.uid
             && exists(/databases/$(database)/documents/maps/$(uid)/shared/$(request.auth.uid))
             && (resource == null || resource.data.get('derived', false) == true) );
      allow delete: if ownerActive(uid)
        || isSelf(rid) // v795: 共有された本人も外せる（自分の共有MAP一覧から消す）
        || ( signedIn() && resource.data.get('derived', false) == true
             && resource.data.get('via', '') == request.auth.uid );
    }

    // ============ プッシュ通知（v366で追加。v355の初回ルール適用時に漏れており通知が止まっていた） ============
    // 通知予約キュー: docId={uid}_{eventId}。本人が自分宛て(uid==自分)の予約だけ作成/更新/削除できる。
    // 送信役のCloud FunctionはAdmin SDKのためルールの対象外（読み取り・削除は常に可能）。
    match /notifQueue/{qid} {
      allow read:   if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && qid.matches(request.auth.uid + '_.*');
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && qid.matches(request.auth.uid + '_.*');
    }
    // FCM端末トークン: 本人のみ登録・掃除できる
    match /users/{uid}/fcmTokens/{tok} {
      allow read, write: if isSelf(uid);
    }

    // ============ v424: マイトレーニング（本人のみ・共有経路とは完全分離） ============
    match /fitness/{uid}/{doc=**} {
      allow read, write: if isSelf(uid);
    }

    // ============ v392: ユニオン共有予定（セミナー等の一括配信・購読型） ============
    // 読み: 同じユニオンに所属するメンバー。書き: オーナー or 同ユニオンの管理者(role=='admin')。
    match /unions/{un}/events/{eid} {
      // v22: オーナーも読める（受付システムの「ユニオン名を変更」で新しい名前へ移すため）
      allow read: if isOwnerAdmin()
                  || (signedIn() && profileExists(request.auth.uid)
                      && profile(request.auth.uid).get('union', '') == un)
                  || isCoreAdminOf(un); // v831: 兼務のユニオン管理者
      allow create, update, delete: if isOwnerAdmin()
        || (signedIn() && profileExists(request.auth.uid)
            && profile(request.auth.uid).get('role', '') == 'admin'
            && profile(request.auth.uid).get('union', '') == un)
        || isCoreAdminOf(un); // v831
    }

    // ============ ATTACK LIST: CDATAフォーマット（ユニオン別テンプレート） ============
    // unions/{ユニオン名}/cdata/template = { fields:[...] }（項目定義のみ・個人情報なし）
    // 読み: ログイン済み。書き: オーナー or そのユニオンの管理者(role=='admin')。
    match /unions/{un}/cdata/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwnerAdmin()
        || (signedIn() && profileExists(request.auth.uid)
            && profile(request.auth.uid).get('role', '') == 'admin'
            && profile(request.auth.uid).get('union', '') == un)
        || isCoreAdminOf(un); // v831: 兼務のユニオン管理者
    }

    // ============ ATTACK LIST：共有コードと受信箱 ============
    // 共有コード: docId=コード。発行した本人だけが作成・削除・一覧できる。
    // コードを知っている人は get で1件だけ読める（一覧は不可＝総当たりで探せない）。
    match /alShareCodes/{code} {
      allow get:    if signedIn();
      allow list:   if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
                    && notDisabled(request.auth.uid)
                    && request.resource.data.exp is number;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
    // 受信箱: 自分宛ての共有の一覧。読めるのは受け取る本人だけ。
    // 書くのは受け取る本人（コードで受け取ったとき）か、共有する側（旧方式からの移行）。
    // ここに書いただけでは人物リストは読めない（閲覧権限は users/{本人}/alShares で判定する）。
    match /alSharedWith/{rid}/from/{ownerUid} {
      allow read:   if isSelf(rid);
      allow create, update: if isSelf(rid) || isSelf(ownerUid);
      allow delete: if isSelf(rid) || isSelf(ownerUid);
    }

    // ============ MAP 受信側の共有インデックス ============
    match /sharedWith/{uid}/from/{ownerUid} {
      allow read:   if isSelf(uid);
      // 共有レコードを作るのはオーナー（ownerUid）本人（v586: 管理者も不可）
      allow write:  if isSelf(ownerUid) && notDisabled(ownerUid);
      allow delete: if isSelf(uid) || isSelf(ownerUid);
    }

    // ============ BASE CHECK-IN（ハウディ受付・稼働率管理） ============
    // 設計: docs/seminar-attendance-design.md
    //   checkinUnions/{ユニオン名}      … 受付システムで有効化されたユニオン
    //   checkinMembers/{QRコード番号}   … 名簿（union フィールドで所属を分離）
    //   checkinEvents/{eventId}        … イベント（unions 配列で合同対応、month で月管理）
    //     └ attendance/{番号|gXXX}     … 出席レコード（union フィールドで集計分離）
    // 権限: 管理 = オーナー or オーナーが受付で任命したユニオン管理者（unionAdmins）・受付管理者（admins）。
    //       受付(出席の記録) = 参加ユニオンの有効メンバーなら誰でも可。

    // コア管理者（受付のユニオン管理者）: オーナー or オーナーが受付で任命した人（checkinUnions/{un}.unionAdmins）。
    // 受付管理者の任命・ユニオンの有効化はこの権限のみ
    // 🔒 v33: NAVIGATORの管理者（role=admin）・NAVIGATORの兼務（coreAdmins）だけでは受付のユニオン管理者にならない
    //   （coreAdmins はNAVIGATORのアカウント管理用として残す。v33移行時に、その時点の管理者を unionAdmins に引き継ぎ）
    function isCkCoreAdmin(un) {
      return isOwnerAdmin()
        || (signedIn() && notDisabled(request.auth.uid)
            && exists(/databases/$(database)/documents/checkinUnions/$(un))
            && get(/databases/$(database)/documents/checkinUnions/$(un)).data.get('unionAdmins', []).hasAny([request.auth.uid]));
    }
    // 受付システムの管理権限: コア管理者 or 任命された受付管理者
    // （checkinUnions/{un}.admins にUIDが登録されたユーザー）
    function isCkAdmin(un) {
      return isCkCoreAdmin(un)
        || (signedIn()
            && exists(/databases/$(database)/documents/checkinUnions/$(un))
            && get(/databases/$(database)/documents/checkinUnions/$(un))
                 .data.get('admins', []).hasAny([request.auth.uid]));
    }
    // ⭐ v32: リーダー（オーナーがユニオンごとに checkinUnions/{un}.leaders に指定。1人で複数ユニオンも可）。
    //   できるのは「名簿・集計の閲覧」「研修生登録の担当（trainers）の任命・解除」「研修生の登録」だけ
    function isCkLeader(un) {
      return signedIn() && notDisabled(request.auth.uid)
        && exists(/databases/$(database)/documents/checkinUnions/$(un))
        && get(/databases/$(database)/documents/checkinUnions/$(un))
             .data.get('leaders', []).hasAny([request.auth.uid]);
    }
    // 🎓 研修生登録の担当: checkinUnions.trainers に任命された人（管理者・リーダーは常に可）。
    // できるのは「研修生の新規登録」と「研修生のチュートリアル記録」だけ（下のルールで限定）
    function isCkTrainer(un) {
      return isCkAdmin(un) || isCkLeader(un)
        || (signedIn() && notDisabled(request.auth.uid)
            && exists(/databases/$(database)/documents/checkinUnions/$(un))
            && get(/databases/$(database)/documents/checkinUnions/$(un))
                 .data.get('trainers', []).hasAny([request.auth.uid]));
    }
    // 🃏 v30: 特別カード（skin系の項目）と BLUE DIAMOND・TEAM ELITE のバッジは、オーナー（馬越さん・北斗さん）だけが付け外しできる
    function ckSkinKeys() {
      return ['skin', 'skinName', 'skinHp', 'skinRare', 'skinSerial', 'skinAbName', 'skinAbText',
              'skinAtkEls', 'skinAtkName', 'skinAtkDmg', 'skinAtkText'];
    }
    function ckTopBadge(b) { return b in ['BLUE DIAMOND', 'TEAM ELITE']; }
    // 👑 受付v108: タイトル（cardTitle）を役職のバッジ（badges）と分けた。BD・TE はタイトルでもオーナーだけ。
    //   古いデータの badge（宝石が入っている人）も今まで通り守る
    function ckTopKeyOk(k) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([k])
        || (!ckTopBadge(resource.data.get(k, '')) && !ckTopBadge(request.resource.data.get(k, '')));
    }
    // 更新: 特別カードの項目を変えない／BD・TEのタイトル（古い badge も）を付けも外しもしない（オーナーは何でも可）
    function ckDecoUpdOk() {
      return isOwnerUid() || (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(ckSkinKeys())
        && ckTopKeyOk('badge') && ckTopKeyOk('cardTitle'));
    }
    // 作成: 特別カードの項目が空・BD/TEのバッジなし
    function ckDecoEmpty(d) {
      return d.get('skin', '') == '' && d.get('skinName', '') == '' && d.get('skinHp', '') == '' && d.get('skinRare', '') == ''
        && d.get('skinSerial', '') == '' && d.get('skinAbName', '') == '' && d.get('skinAbText', '') == ''
        && d.get('skinAtkEls', '') == '' && d.get('skinAtkName', '') == '' && d.get('skinAtkDmg', '') == '' && d.get('skinAtkText', '') == ''
        && !ckTopBadge(d.get('badge', '')) && !ckTopBadge(d.get('cardTitle', ''));
    }
    // 会員証の発行・再発行: 名簿（オーナーしか変えられない）と同じ値なら、スタッフがそのまま引き継げる
    function ckDecoSameAs(d, m) {
      return d.get('skin', '') == m.get('skin', '') && d.get('skinName', '') == m.get('skinName', '') && d.get('skinHp', '') == m.get('skinHp', '')
        && d.get('skinRare', '') == m.get('skinRare', '') && d.get('skinSerial', '') == m.get('skinSerial', '')
        && d.get('skinAbName', '') == m.get('skinAbName', '') && d.get('skinAbText', '') == m.get('skinAbText', '')
        && d.get('skinAtkEls', '') == m.get('skinAtkEls', '') && d.get('skinAtkName', '') == m.get('skinAtkName', '')
        && d.get('skinAtkDmg', '') == m.get('skinAtkDmg', '') && d.get('skinAtkText', '') == m.get('skinAtkText', '')
        && (!ckTopBadge(d.get('badge', '')) || d.get('badge', '') == m.get('badge', ''))
        && (!ckTopBadge(d.get('cardTitle', '')) || d.get('cardTitle', '') == m.get('cardTitle', ''));
    }
    function ckCardDecoNewOk(d) {
      return isOwnerUid() || ckDecoEmpty(d)
        || (existsAfter(/databases/$(database)/documents/checkinMembers/$(d.get('no', '__none')))
            && ckDecoSameAs(d, getAfter(/databases/$(database)/documents/checkinMembers/$(d.get('no', '__none'))).data));
    }
    // 研修生の受講記録のどれかを、この人が受講済みにした
    function ckTrainedBy(d) {
      let t = d.get('trainings', {});
      let u = request.auth.uid;
      return t.get('PG', {}).get('by', '') == u || t.get('DLR', {}).get('by', '') == u || t.get('PA', {}).get('by', '') == u
        || t.get('EXP', {}).get('by', '') == u || t.get('CO', {}).get('by', '') == u || t.get('BPC済み', {}).get('by', '') == u;
    }
    // 自分のプロフィールの所属ユニオン
    function ckMyUnion() {
      return profileExists(request.auth.uid)
        ? profile(request.auth.uid).get('union','') : '';
    }
    // 🔒 v17: ユニオンのデータ（名簿・稼働率など）を見られる人 =
    //   オーナー／そのユニオンの所属メンバー／そのユニオンの管理者（コア・受付管理者）／研修生登録の担当
    // （他ユニオンの人は見られない。来場した他ユニオンの人は会員証トークンで照会する＝cards/cardClaims）
    function ckCanSee(un) {
      return isOwnerAdmin()
        || (signedIn() && notDisabled(request.auth.uid)
            && (ckMyUnion() == un || isCkAdmin(un) || isCkTrainer(un)));   // ⭐ v32: リーダーは isCkTrainer に含む
    }
    // イベント配下（出席・予約・会計・操作ログ）を見られる人 =
    //   オーナー／参加ユニオンの所属メンバー／主催ユニオン・参加ユニオン（合同は2つ目まで）の管理者
    function ckEventStaff(eid) {
      return isOwnerAdmin()
        || (signedIn() && notDisabled(request.auth.uid)
            && ckEventStaffOf(get(/databases/$(database)/documents/checkinEvents/$(eid)).data));
    }
    function ckEventAdminOf(ev) {
      return isCkAdmin(ev.get('hostUnion', ''))
        || (ev.get('unions', []).size() > 0 && isCkAdmin(ev.get('unions', [])[0]))
        || (ev.get('unions', []).size() > 1 && isCkAdmin(ev.get('unions', [])[1]));
    }
    function ckEventStaffOf(ev) {
      return ev.get('unions', []).hasAny([ckMyUnion()])
        || isCkAdmin(ev.get('hostUnion', ''))
        || (ev.get('unions', []).size() > 0 && isCkAdmin(ev.get('unions', [])[0]))
        || (ev.get('unions', []).size() > 1 && isCkAdmin(ev.get('unions', [])[1]));
    }

    // 📜 v27: 研修担当者の秘密保持契約（研修生登録ページを初めて使う時に誓約）。docId = {uid}__{様式の版}
    //   本人だけが作成（自分のユニオンで）。作成後は本人も書き換え・削除できない（削除はオーナーのみ）。
    //   見られるのは本人・そのユニオンの管理者（受付管理者含む）・オーナー
    match /trainerNda/{id} {
      allow get: if signedIn() && (id.split('__')[0] == request.auth.uid
        || (resource != null && (isOwnerAdmin() || isCkAdmin(resource.data.get('union', ''))
            || isCkLeader(resource.data.get('union', '')))));   // ⭐ v32: リーダーも（研修担当の任命画面で誓約済みかを見る）
      allow list: if isOwnerAdmin() || isCkAdmin(resource.data.get('union', '')) || isCkLeader(resource.data.get('union', ''));
      allow create: if signedIn() && notDisabled(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '__' + request.resource.data.ver
        && request.resource.data.keys().hasOnly(['uid', 'name', 'address', 'union', 'ver', 'agreedAt', 'atMs', 'atLocal'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 200
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20
        && request.resource.data.union == profile(request.auth.uid).get('union', '')
        && request.resource.data.agreedAt == request.time;
      allow update: if false;
      allow delete: if isOwnerAdmin();
    }

    match /checkinUnions/{un} {
      allow read: if signedIn();
      // 有効化・受付管理者(admins)の変更はコア管理者のみ。
      // 受付管理者は発行者名(issuer)などadmins以外の設定は変更できる
      // 兼務のユニオン管理者（coreAdmins）の指定・解除はオーナーのみ
      // ⭐ v32: リーダー（leaders）の指定・解除もオーナーのみ。リーダーは研修生登録の担当（trainers）だけ変えられる
      // 🔒 v33: 受付のユニオン管理者（unionAdmins）の任命・解除もオーナーのみ
      allow create: if isCkCoreAdmin(un)
        && (isOwnerAdmin() || (!('coreAdmins' in request.resource.data) && !('leaders' in request.resource.data) && !('unionAdmins' in request.resource.data)));
      allow update: if (isCkCoreAdmin(un)
            && (isOwnerAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coreAdmins', 'leaders', 'unionAdmins', 'ckMig33'])))
        || (isCkLeader(un)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trainers']))
        // 🎓 v25: 研修生登録の担当（trainers）の任命・解除もユニオン管理者（コア管理者）だけ。受付管理者は不可
        // 🙈 v29: 受付の金額を統括だけに見せる設定（hideMoney）もユニオン管理者だけ
        || (isCkAdmin(un)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admins', 'coreAdmins', 'trainers', 'hideMoney', 'leaders', 'unionAdmins', 'ckMig33']));
      allow delete: if isOwnerAdmin();
    }

    // 📊 稼働率の集計結果（受付システムが計算して保存 → GROOVE MAPの受付連携は読むだけ）
    //   docId = {ユニオン}__{YYYY-MM}。書けるのはそのユニオンの有効メンバー・受付管理者・オーナー
    match /checkinStats/{sid} {
      allow read: if resource == null || ckCanSee(resource.data.get('union', ''))
        // 🔗 v82: 連携先ユニオン向けの集計（{ユニオン}__{key}__to__{連携先}・「MAPで連携するユニオン」の人の分だけ）は連携先ユニオンの人も読める
        || (signedIn() && notDisabled(request.auth.uid)
            && resource.data.get('view', '') != '' && resource.data.get('view', '') == ckMyUnion());
      allow create, update: if isOwnerAdmin()
        || isCkAdmin(request.resource.data.get('union', ''))
        || (signedIn() && notDisabled(request.auth.uid)
            && request.resource.data.get('union', '') == ckMyUnion());
      allow delete: if isOwnerAdmin();
    }

    function ckAlsoSee() {
      return signedIn() && notDisabled(request.auth.uid) && ckMyUnion() != ''
        && ckMyUnion() in resource.data.alsoUnions;
    }
    match /checkinMembers/{no} {
      // 🔒 見られるのは自分が関わるユニオンの名簿だけ（ckCanSee）。一覧は union で絞った検索のみ。
      // 存在しない番号の get は可（研修生登録の番号の空き確認に使う・中身は何も見えない）
      allow get: if resource == null || ckCanSee(resource.data.get('union',''))
        // 🔗 v770: NAVIGATORのアカウントに紐付いた本人の名簿（ログイン時に「受付で無効」かを見る）
        || (signedIn() && profileExists(request.auth.uid)
            && profile(request.auth.uid).get('ckNo', '') == no)
        || ckAlsoSee();
      // 🔗 v82: ほかの地域のユニオンのチームで活動している人（名簿の alsoUnions に自分のユニオン）は、その人だけ見られる
      //   GROOVE MAPの受付連携は where('alsoUnions','array-contains', 自分のユニオン) で読む
      allow list: if ckCanSee(resource.data.get('union','')) || ckAlsoSee();
      allow create: if isCkAdmin(request.resource.data.get('union',''))
                    && (isOwnerUid() || ckDecoEmpty(request.resource.data));   // 🃏 v30
      allow update: if isCkAdmin(resource.data.get('union',''))
                    && isCkAdmin(request.resource.data.get('union', resource.data.get('union','')))
                    && ckDecoUpdOk();   // 🃏 v30: 特別カード・BD/TEのタイトル（・古いバッジ）はオーナーだけ
      // 会員証の発行・再発行・無効化はログイン済みなら誰でも可
      // （変更できるのはカード関連フィールドのみ。名簿本体の編集は管理者のみ）
      allow update: if ckCanSee(resource.data.get('union',''))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['cardToken','cardSig','cardStatus','claimName']);
      // 🎓 研修生登録の担当: 研修生（trainee=true）の新規登録と、
      // 研修生のチュートリアル記録（trainings）・CO面談シート（coSheet）・
      // 紹介者（referrer）・DLR予約（dlrRsv）の更新、自分が登録した研修生の削除（取消用）だけ可
      allow create: if isCkTrainer(request.resource.data.get('union',''))
                    && request.resource.data.get('trainee', false) == true
                    && ckDecoEmpty(request.resource.data);
      allow update: if isCkTrainer(resource.data.get('union',''))
                    && resource.data.get('trainee', false) == true
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['trainings','coSheet','referrer','dlrRsv']);
      // 🗑 v31: 研修担当は、自分が担当した研修生（自分が登録した・どれかを受講済みにした）を削除できる（研修生のあいだだけ）
      allow delete: if isCkTrainer(resource.data.get('union',''))
                    && resource.data.get('trainee', false) == true
                    && (resource.data.get('regBy','') == request.auth.uid || ckTrainedBy(resource.data));
      allow delete: if isCkAdmin(resource.data.get('union',''));
    }

    match /checkinEvents/{eid} {
      // セルフチェックイン(会員証ページ・未ログイン)からイベント情報を参照するため公開読取
      allow read: if true;
      // 作成は主催ユニオンの管理者。主催は必ず参加ユニオンに含める
      allow create: if isCkAdmin(request.resource.data.get('hostUnion',''))
                    && request.resource.data.get('unions',[])
                         .hasAny([request.resource.data.get('hostUnion','')]);
      allow update, delete: if isCkAdmin(resource.data.get('hostUnion',''));
      // Zoom参加情報（URL・ミーティングID・パスコード）と受付終了フラグ（recClosed）の
      // 登録・変更はログイン済みメンバーなら可（受付・オンライン受付の運用者向け）
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['zoomUrl', 'zoomId', 'zoomPw', 'recClosed']);

      match /attendance/{aid} {
        allow read: if ckEventStaff(eid);
        // 📊 v21: 自分が見られるユニオン（ckCanSee）のメンバーの出席は、他ユニオンのイベントでも読める
        // （集計の「他ユニオンイベントへの出席（参考）」用。一覧は union で絞った検索のみ）
        allow read: if ckCanSee(resource.data.get('union', ''));
        // 通常受付: オーナー、または参加ユニオン(unions配列)に所属する有効メンバー
        allow create, update, delete: if isOwnerAdmin()
          || (signedIn()
              && notDisabled(request.auth.uid)
              && get(/databases/$(database)/documents/checkinEvents/$(eid))
                   .data.get('unions',[]).hasAny([ckMyUnion()]));
        // セルフチェックイン: 未ログインでも「有効な会員証トークンを持つ本人」が、
        // セルフ受付中(mode=self かつ selfOpen=true)のイベントに自分の出席を1回だけ作成できる。
        // 会場コード必須のイベントはコード一致も要求。update不可なので二重・改ざんは不可。
        allow create: if request.auth == null
          && get(/databases/$(database)/documents/checkinEvents/$(eid))
               .data.get('mode','') == 'self'
          && get(/databases/$(database)/documents/checkinEvents/$(eid))
               .data.get('selfOpen', false) == true
          && exists(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
          && get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
               .data.get('no','') == aid
          && get(/databases/$(database)/documents/checkinEvents/$(eid))
               .data.get('unions',[])
               .hasAny([get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
                          .data.get('union','')])
          && (get(/databases/$(database)/documents/checkinEvents/$(eid))
                .data.get('requireCode', false) != true
              || request.resource.data.get('code','') ==
                 get(/databases/$(database)/documents/checkinEvents/$(eid))
                   .data.get('venueCode','__none'));
        // オンライン受講申請: 未ログインでも「有効な会員証トークンを持つ本人」が、
        // オンライン対応イベント(online=true)に承認待ち(status=pending, paid=false)の
        // 申請を1回だけ作成できる。承認・却下はログイン済みメンバーが update で行う。
        allow create: if request.auth == null
          && get(/databases/$(database)/documents/checkinEvents/$(eid))
               .data.get('online', false) == true
          && request.resource.data.get('method','') == 'online'
          && request.resource.data.get('status','') == 'pending'
          && request.resource.data.get('paid', true) == false
          && exists(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
          && get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
               .data.get('no','') == aid
          && get(/databases/$(database)/documents/checkinEvents/$(eid))
               .data.get('unions',[])
               .hasAny([get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
                          .data.get('union','')]);
      }

      // 🎟 予約（RSVP）: 会員証（未ログイン）から本人が1回だけ予約を作成できる。
      // 対象は rsvp=true のイベントのみ。トークン照合で本人確認、update不可＝改ざん・二重予約は不可。
      // 受付側の追加・削除は出席と同じ権限（参加ユニオンの有効メンバー）
      match /rsvps/{rid} {
        allow read: if ckEventStaff(eid);
        allow create: if request.auth == null
          && get(/databases/$(database)/documents/checkinEvents/$(eid))
               .data.get('rsvp', false) == true
          && exists(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
          && get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
               .data.get('no','') == rid
          && get(/databases/$(database)/documents/checkinEvents/$(eid))
               .data.get('unions',[])
               .hasAny([get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
                          .data.get('union','')]);
        allow create, delete: if isOwnerAdmin()
          || (signedIn()
              && notDisabled(request.auth.uid)
              && get(/databases/$(database)/documents/checkinEvents/$(eid))
                   .data.get('unions',[]).hasAny([ckMyUnion()]));
      }

      // 🎟 予約の取消申請: 本人（未ログイン・会員証トークン照合）が自分の番号で1件だけ作成できる。
      // 予約docの存在は求めない（受付側で先に削除済みでも、会員証の「予約済み」表示を解除する
      // 依頼として受付に届くようにするため）。
      // 本人による変更・削除は不可＝確定操作は受付（承認=予約と申請を削除／却下=申請のみ削除）
      match /rsvpCancels/{rid} {
        allow read: if ckEventStaff(eid);
        allow create: if request.auth == null
          && exists(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
          && get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
               .data.get('no','') == rid;
        allow update: if false;
        allow delete: if signedIn();
      }

      // 会計（BASE集計表）: 参加ユニオンの有効メンバーが記録できる
      // 💴 v20: 会計は主催・参加ユニオンのユニオン管理者・受付管理者（兼務含む）とオーナーだけ（一般メンバーは不可）
      match /finance/{fid} {
        allow read, create, update, delete: if isOwnerAdmin()
          || (signedIn() && notDisabled(request.auth.uid)
              && ckEventAdminOf(get(/databases/$(database)/documents/checkinEvents/$(eid)).data));
      }

      // 💰 お金の操作ログ: 追記専用（だれも編集・削除できない＝改ざん防止）。
      // 記録の作成はログイン済みの有効ユーザーなら可（会計操作と同時にアプリが自動追記する）
      // 🔒 v18: 見られるのはオーナーと主催ユニオンのユニオン管理者（MAPの管理者）だけ。受付管理者・一般メンバーは不可
      match /audit/{aid} {
        allow read: if isOwnerAdmin()
          || (signedIn() && notDisabled(request.auth.uid)
              && isCkCoreAdmin(get(/databases/$(database)/documents/checkinEvents/$(eid)).data.get('hostUnion', '')));
        allow create: if isOwnerAdmin()
          || (signedIn() && notDisabled(request.auth.uid));
        allow update, delete: if false;
      }
    }

    // 🖤 v26: 会員証デザインの解禁スイッチ（checkinConfig/launch）。
    //   会員証は未ログインで開くので誰でも読める（中身は解禁のON/OFFと予約日時だけ）。書けるのはオーナーだけ
    match /checkinConfig/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwnerUid() && id == 'launch'
        && request.resource.data.keys().hasOnly(['platinum', 'platinumAt', 'by', 'at'])
        && request.resource.data.platinum is bool
        && request.resource.data.platinumAt is int && request.resource.data.platinumAt >= 0
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isOwnerUid();
    }

    // スマホ会員証: トークン(URL)を知っている本人だけが自分のカードを表示できる。
    // get のみ公開（list 不可＝一覧の抜き出しはできない）。
    // 発行・再発行・無効化はログイン済みなら誰でも可（受付スタッフが配布できるように）。
    // 受け取りリンク用: 会員番号 → 会員証トークンの対応表。
    // 共通URLから本人が自分の番号でカードを開くために get のみ公開（list 不可）。
    // 作成・更新・削除は発行/再発行/無効化と連動（ログイン済みのみ）。
    // 番号→会員証（受付のビジター照会など、ログインしている人だけ）。
    // 🔒 v19: 未ログインでは読めない（番号だけで他人の会員証が開けてしまうため）。受け取りリンクは cardKeys を使う
    match /cardClaims/{no} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if signedIn();
    }

    // 🔑 受け取りリンク用: cardKeys/{sha256(番号|お名前)} = { t: 会員証トークン, no }
    //   番号とお名前（姓 or フルネーム）の両方が合う時だけ見つかる。一覧は不可
    match /cardKeys/{k} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['t', 'no'])
        && request.resource.data.get('t', '') is string
        && request.resource.data.get('no', '') is string;
      allow delete: if signedIn();
    }

    match /cards/{token} {
      allow get: if true;
      allow list: if false;
      // 🃏 v30: 特別カードの項目・BD/TEバッジは、名簿と同じ値（発行・再発行の引き継ぎ）かオーナーだけ
      allow create: if signedIn() && ckCardDecoNewOk(request.resource.data);
      allow delete: if signedIn();
      // オンライン申請の承認結果マーカー(online_<eventId>)の書込みに使用
      allow update: if signedIn() && ckDecoUpdOk();
    }
    // 🃏 v30: 特別カード工房。カードセットの定義（色・文字・付けた人・画像の版）と画像（data URL・1枚ずつ）、
    //   ユニオンごとの裏面の設定。会員証は未ログインで開くので get は公開、作る・変えるのはオーナーだけ
    match /cardSkins/{id} {
      allow get: if true;
      allow list, create, update, delete: if isOwnerUid();
    }
    match /cardArt/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isOwnerUid();
    }
    match /cardBacks/{un} {
      allow get: if true;
      allow list, create, update, delete: if isOwnerUid();
    }
    // 🃏 v24: 参加者のコレクション（OLチェックアウトの控え）。パスに会員証トークンが入る＝本人だけが開ける（cards と同じ扱い）
    //   作成＝チェックアウトと同時（同じIDの olCheckouts が同じ番号で作られること）。会員証の再発行時は新しいトークンへ写す
    match /cards/{token}/ol/{id} {
      allow get, list: if true;
      allow create: if exists(/databases/$(database)/documents/cards/$(token))
        && get(/databases/$(database)/documents/cards/$(token)).data.get('no', '') == request.resource.data.get('no', '__x')
        && existsAfter(/databases/$(database)/documents/olCheckouts/$(id))
        && getAfter(/databases/$(database)/documents/olCheckouts/$(id)).data.get('no', '') == request.resource.data.get('no', '__x');
      allow update: if false;
      allow delete: if signedIn();
    }
    // 👤 #21 受付v109: プロフィール（タイトルが RUBY 以上の人が、本人の会員証から書く）
    //   cards/{トークン}/prof/me = 本人の分（パスにトークン＝トークンを持っている本人だけが書ける）
    //   cardProfiles/{番号}      = 公開用の写し（コレクションの「詳細」用。会員証トークンは入れない）。
    //     同じ一括書き込みで本人の分を書き換えた時だけ書ける（中身が一致すること）＝他人の番号では書けない
    //   会員証の再発行（無効化→発行も）では、受付・管理者が写しから新しい会員証へ戻す
    function ckProfTitleOk(d) {
      return d.get('trainee', false) != true && d.get('rcptOnly', false) != true && d.get('active', true) != false
        && (d.get('cardTitle', '') != '' ? d.get('cardTitle', '') : d.get('badge', ''))
             in ['RUBY', 'EMERALD', 'DIAMOND', 'BLUE DIAMOND', 'TEAM ELITE'];
    }
    function ckProfShapeOk(d) {
      return d.get('intro', '') is string && d.get('intro', '').size() <= 200
        && d.get('good', '') is string && d.get('good', '').size() <= 100
        && d.get('bad', '') is string && d.get('bad', '').size() <= 100
        && d.get('atMs', 0) is int;
    }
    match /cards/{token}/prof/{pid} {
      allow get: if true;
      allow list: if false;
      allow create, update: if pid == 'me'
        && request.resource.data.keys().hasOnly(['intro', 'good', 'bad', 'atMs'])
        && ckProfShapeOk(request.resource.data)
        && exists(/databases/$(database)/documents/cards/$(token))
        && (ckProfTitleOk(get(/databases/$(database)/documents/cards/$(token)).data)
            || (signedIn() && notDisabled(request.auth.uid)));   // 再発行の引き継ぎ（受付・管理者）
      allow delete: if signedIn();
    }
    function ckProfSame(p, d) {
      return existsAfter(p)
        && getAfter(p).data.get('intro', '') == d.get('intro', '')
        && getAfter(p).data.get('good', '') == d.get('good', '')
        && getAfter(p).data.get('bad', '') == d.get('bad', '')
        && getAfter(p).data.get('atMs', 0) == d.get('atMs', 0)
        && (!exists(p) || get(p).data.get('atMs', 0) != d.get('atMs', 0));   // この書き込みで本人の分も書き換えた
    }
    match /cardProfiles/{no} {
      allow get: if signedIn() && notDisabled(request.auth.uid);   // ログインしたNAVIGATOR・受付の人だけ（番号で1件ずつ）
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['no', 'intro', 'good', 'bad', 'atMs'])
        && request.resource.data.get('no', '') == no
        && ckProfShapeOk(request.resource.data)
        && exists(/databases/$(database)/documents/checkinMembers/$(no))
        && ckProfSame(/databases/$(database)/documents/cards/$(get(/databases/$(database)/documents/checkinMembers/$(no)).data.get('cardToken', '__none'))/prof/me,
             request.resource.data);
      allow delete: if isOwnerAdmin()
        || (signedIn() && notDisabled(request.auth.uid)
            && (!exists(/databases/$(database)/documents/checkinMembers/$(no))   // 名簿から削除した人の後片付け
                || ckCanSee(get(/databases/$(database)/documents/checkinMembers/$(no)).data.get('union', ''))));
    }

    // 📝 CO面談シートの本人入力（下書き送信箱）:
    //   担当者が本人の会員証に解錠マーカー（cards.coOpen・期限つき）を付けている間だけ、
    //   本人（未ログイン・トークン照合）が下書きを1件送信できる。
    //   読み取りはその人のユニオンを見られる担当者・管理者のみ（電話・住所など個人情報を含むため）。
    //   本人による変更・削除は不可＝正式記録は担当者が checkinMembers.coSheet へ保存して確定。
    // 🔔 v28: 解錠した担当者（cards.coOpen.byUid）に届く。trUid/trName/union は解錠時の記録と一致すること。
    //   届いた担当者本人と、そのユニオンの管理者（24時間たっても未承認の時のお知らせ用）も読める・消せる
    match /coSheetInbox/{iid} {
      allow read: if isOwnerAdmin()
        || (signedIn() && resource.data.get('trUid', '') == request.auth.uid)
        || isCkAdmin(resource.data.get('union', '__none'))
        || (exists(/databases/$(database)/documents/checkinMembers/$(resource.data.get('no','__none')))
            && ckCanSee(get(/databases/$(database)/documents/checkinMembers/$(resource.data.get('no','__none'))).data.get('union','')));
      allow create: if request.resource.data.keys().hasOnly(
          ['no','name','cardToken','ver','checks','pledge','date','sign','phone','addrBirth',
           'referrer','manager','atLocal','atMs','trUid','trName','union'])
        && exists(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
        && get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
             .data.get('no','') == request.resource.data.get('no','__x')
        && get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
             .data.get('coOpen', {}).get('until', 0) > request.time.toMillis()
        && request.resource.data.get('trUid', '') == get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
             .data.get('coOpen', {}).get('byUid', '')
        && request.resource.data.get('union', '') in ['', get(/databases/$(database)/documents/cards/$(request.resource.data.get('cardToken','__none')))
             .data.get('union', '')]   // 空＝更新前のアプリからの送信
        && request.resource.data.get('trName', '') is string && request.resource.data.get('trName', '').size() <= 60;
      allow update: if false;
      allow delete: if isOwnerAdmin()   // 担当者の保存時の掃除用
        || (signedIn() && resource.data.get('trUid', '') == request.auth.uid)
        || isCkAdmin(resource.data.get('union', '__none'))
        || (exists(/databases/$(database)/documents/checkinMembers/$(resource.data.get('no','__none')))
            && ckCanSee(get(/databases/$(database)/documents/checkinMembers/$(resource.data.get('no','__none'))).data.get('union','')));
    }

    // 📝 目標設定の宿題（研修生がPAのあと会員証から答える。NAVIGATORの目標設定と同じ質問・同じ形式）
    //   ドキュメントID = 会員証のトークン（URLを知っている本人と担当者だけが開ける＝cards と同じ扱い）
    //   v23: 本人（未ログイン）: 会員証にPG（以前はPA）の受講記録がある間だけ提出・書き直しできる。
    //   届け先はPGの担当者（trUid）に固定。PGの記録がない以前の人はPAの担当者
    //   担当者・そのユニオンの研修担当/管理者・オーナー: 一覧・既読・書き直し依頼・削除
    match /goalHw/{t} {
      allow get: if true;
      allow list: if signedIn() && notDisabled(request.auth.uid)
        && (resource.data.get('trUid', '') == request.auth.uid
            || isCkTrainer(resource.data.get('union', ''))
            || isOwnerAdmin());
      allow create, update: if (
          request.resource.data.keys().hasOnly(['no','name','union','group','trUid','trName','ans','total','status','atMs','atLocal','ver'])
          && request.resource.data.get('status', '') == 'submitted'
          && request.resource.data.get('ans', null) is map
          && request.resource.data.ans.size() <= 40
          && exists(/databases/$(database)/documents/cards/$(t))
          && get(/databases/$(database)/documents/cards/$(t)).data.get('rcptOnly', false) == false
          && get(/databases/$(database)/documents/cards/$(t)).data.get('no', '') == request.resource.data.get('no', '__x')
          && get(/databases/$(database)/documents/cards/$(t)).data.get('union', '') == request.resource.data.get('union', '__x')
          && (
            (get(/databases/$(database)/documents/cards/$(t)).data.get('trainings', {}).get('PG', null) != null
              && get(/databases/$(database)/documents/cards/$(t)).data.get('trainings', {}).get('PG', {}).get('by', '') == request.resource.data.get('trUid', '__x'))
            || (get(/databases/$(database)/documents/cards/$(t)).data.get('trainings', {}).get('PA', null) != null
              && get(/databases/$(database)/documents/cards/$(t)).data.get('trainings', {}).get('PA', {}).get('by', '') == request.resource.data.get('trUid', '__x'))
          )
        );
      // 担当側: 既読・書き直し依頼（中身は変えられない）／会員証の再発行時の付け替え
      allow update: if signedIn() && notDisabled(request.auth.uid)
        && (resource.data.get('trUid', '') == request.auth.uid || isCkTrainer(resource.data.get('union', '')))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'seenMs', 'redoMs', 'redoBy'])
        && request.resource.data.get('status', '') in ['submitted', 'redo'];
      allow create: if signedIn() && notDisabled(request.auth.uid) && isCkTrainer(request.resource.data.get('union', ''));
      allow delete: if isOwnerAdmin()
        || (signedIn() && notDisabled(request.auth.uid) && isCkTrainer(resource.data.get('union', '')));
    }

    // 🎓 v24: OLチェックアウト（アウトラインの後に、参加者がAさんのQRを読んで感想・気づき・タスクを送る）
    //   olHosts/{key}: Aさん（OLをする人）。key＝QRに入る公開キー（会員証トークンとは別物＝撮られても会員証は開けない）
    //     設定はオーナー・そのユニオンの管理者。count/lastId はチェックアウトのたびに参加者が1つ進める（通し番号＝何人目か）
    match /olHosts/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if isCkAdmin(request.resource.data.get('union', ''));
      allow update: if (isCkAdmin(resource.data.get('union', '')) && isCkAdmin(request.resource.data.get('union', '')))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastId'])
            && request.resource.data.get('count', 0) == resource.data.get('count', 0) + 1
            && getAfter(/databases/$(database)/documents/olCheckouts/$(request.resource.data.get('lastId', '__none'))).data.get('key', '') == key
            && getAfter(/databases/$(database)/documents/olCheckouts/$(request.resource.data.get('lastId', '__none'))).data.get('serial', -1) == request.resource.data.get('count', 0));
      allow delete: if isCkAdmin(resource.data.get('union', ''));
    }
    //   olCheckouts/{key_番号_YYYYMMDD}: チェックアウト（同じAさんへは1日1回）。
    //     作成＝参加者（未ログイン）。会員証の番号・お名前・ユニオンが名簿の会員証と一致すること（cardClaims→cards で照合）
    //     見る＝そのユニオンを見られる人（アップライン・ユニオン管理者・オーナー＝名簿と同じ範囲）＋Aさん本人＋参加者本人（NAVIGATORの紐付け ckNo）
    //     参加者本人のNAVIGATORは、タスクを自分のToDo・予定に取り込んだ印（taskImported）だけ付けられる
    match /olCheckouts/{id} {
      allow get, list: if ckCanSee(resource.data.get('union', ''))
        || (signedIn() && profileExists(request.auth.uid)
            && (profile(request.auth.uid).get('ckNo', '__x') == resource.data.get('aNo', '__y')
                || profile(request.auth.uid).get('ckNo', '__x') == resource.data.get('no', '__y')));
      allow create: if request.resource.data.keys().hasOnly(
            ['key', 'no', 'name', 'union', 'group', 'aNo', 'aName', 'aUnion', 'special', 'serial', 'design',
             'impression', 'notice', 'task', 'ymd', 'atMs', 'atLocal', 'ver'])
        && id == request.resource.data.get('key', '') + '_' + request.resource.data.get('no', '') + '_' + request.resource.data.get('ymd', '')
        && request.resource.data.get('impression', '') is string && request.resource.data.impression.size() > 0 && request.resource.data.impression.size() <= 1000
        && request.resource.data.get('notice', '') is string && request.resource.data.notice.size() > 0 && request.resource.data.notice.size() <= 1000
        && request.resource.data.get('task', {}) is map && request.resource.data.get('task', {}).size() <= 4
        && exists(/databases/$(database)/documents/olHosts/$(request.resource.data.get('key', '__none')))
        && get(/databases/$(database)/documents/olHosts/$(request.resource.data.key)).data.get('on', false) == true
        && get(/databases/$(database)/documents/olHosts/$(request.resource.data.key)).data.get('no', '') == request.resource.data.get('aNo', '__x')
        && getAfter(/databases/$(database)/documents/olHosts/$(request.resource.data.key)).data.get('lastId', '') == id
        && getAfter(/databases/$(database)/documents/olHosts/$(request.resource.data.key)).data.get('count', 0) == request.resource.data.get('serial', -1)
        && exists(/databases/$(database)/documents/cardClaims/$(request.resource.data.get('no', '__none')))
        && ckOlCard(get(/databases/$(database)/documents/cardClaims/$(request.resource.data.no)).data.get('t', '__none'), request.resource.data);
      allow update: if signedIn() && profileExists(request.auth.uid)
        && profile(request.auth.uid).get('ckNo', '__x') == resource.data.get('no', '__y')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taskImported', 'taskImportedAt']);
      allow delete: if isOwnerAdmin() || isCkAdmin(resource.data.get('union', ''));
    }
    // チェックアウトした会員証が、名簿の本人の有効な会員証であること
    function ckOlCard(t, d) {
      return exists(/databases/$(database)/documents/cards/$(t))
        && get(/databases/$(database)/documents/cards/$(t)).data.get('no', '') == d.get('no', '__x')
        && get(/databases/$(database)/documents/cards/$(t)).data.get('name', '') == d.get('name', '__x')
        && get(/databases/$(database)/documents/cards/$(t)).data.get('union', '') == d.get('union', '__x')
        && get(/databases/$(database)/documents/cards/$(t)).data.get('active', true) != false
        && get(/databases/$(database)/documents/cards/$(t)).data.get('rcptOnly', false) == false;
    }

    // オンライン受講の誓約書アーカイブ:
    //   会員証ページ（未ログイン）から申請時に同意記録を作成。改変・削除は不可（アーカイブ）
    match /checkinPledges/{pid} {
      allow read: if ckCanSee(resource.data.get('union',''));
      allow create: if request.resource.data.keys().hasOnly(
        ['no', 'name', 'group', 'union', 'eventId', 'eventDate', 'eventName',
         'ver', 'envApprover', 'at', 'atLocal', 'atMs', 'cardToken']);
      allow update, delete: if false;
    }

    // ============ v816: 使い勝手レビュー（期間限定のアンケート） ============
    //   rvConfig/main … 回（round）・タイトル・期間・結果を見られる人（viewers）。書けるのはオーナーだけ
    //   rvAnswers/{round}_{uid} … 1人1件（期間中は直せる）。名前・ユニオンはプロフィールのもの（自分で書きかえられない）
    //   読めるのは本人と、オーナー・結果を見られる人だけ
    function rvViewer() {
      return isOwnerAdmin() || (signedIn() && notDisabled(request.auth.uid)
        && exists(/databases/$(database)/documents/rvConfig/main)
        && request.auth.uid in get(/databases/$(database)/documents/rvConfig/main).data.get('viewers', []));
    }
    function rvAnswerOk(d) {
      let cfg = get(/databases/$(database)/documents/rvConfig/main).data;
      return d.keys().hasOnly(['round','uid','name','union','ver','device','a','createdAt','updatedAt'])
        && d.uid == request.auth.uid
        && d.round == cfg.get('round', '')
        && d.name == profile(request.auth.uid).get('name', '')
        && d.union == profile(request.auth.uid).get('union', '')
        && d.a is map
        && d.updatedAt == request.time
        // v823: 「開発メンバーだけ」の時は、オーナーとバグ・要望・アイデアを見られる人だけが答えられる
        && (cfg.get('scope', 'all') != 'dev' || isOwnerAdmin()
            || (exists(/databases/$(database)/documents/fbConfig/main)
                && request.auth.uid in get(/databases/$(database)/documents/fbConfig/main).data.get('members', [])));
    }
    match /rvConfig/main {
      allow read: if signedIn();
      allow write: if isOwnerAdmin();
    }
    match /rvAnswers/{id} {
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || rvViewer());
      allow list: if rvViewer();
      allow create: if signedIn() && notDisabled(request.auth.uid)
        && exists(/databases/$(database)/documents/rvConfig/main)
        && id == request.resource.data.round + '_' + request.auth.uid
        && rvAnswerOk(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && notDisabled(request.auth.uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.round == resource.data.round
        && request.resource.data.createdAt == resource.data.createdAt
        && rvAnswerOk(request.resource.data);
      allow delete: if isOwnerAdmin();
    }

    // ============ v585: バグ・要望（オーナー＋オーナーが指定した人だけ）。v817: バグ・要望・アイデア（状態・期限はオーナー＝山内さん・馬越さん） ============
    //   fbConfig/main.members に入っている人とオーナーだけが読み書きできる。指定はオーナーだけ。
    //   書いた人（uid・プロフィールの名前）と日時（サーバー時刻）は書き換えられない。
    function fbOk() {
      return isOwnerAdmin() || (signedIn() && notDisabled(request.auth.uid)
        && exists(/databases/$(database)/documents/fbConfig/main)
        && request.auth.uid in get(/databases/$(database)/documents/fbConfig/main).data.get('members', []));
    }
    function fbName() { return profile(request.auth.uid).get('name', ''); }
    function fbMineNew(id) { // v822: 自分が書いた「新着」の報告
      let it = get(/databases/$(database)/documents/fbItems/$(id)).data;
      return fbOk() && it.get('authorUid', '') == request.auth.uid && it.get('status', '') == 'new';
    }
    match /fbConfig/main {
      allow read: if fbOk();
      allow write: if isOwnerAdmin();
    }
    // 通し番号（#1, #2…）：1つずつしか増やせない
    match /fbConfig/seq {
      allow read: if fbOk();
      allow create: if fbOk() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if fbOk() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
    match /fbItems/{id} {
      allow read: if fbOk();
      allow create: if fbOk()
        && request.resource.data.keys().hasOnly(['no','kind','screen','title','did','got','want','ver','device','status','authorUid','authorName','createdAt','imgN','app','reqBy','slackUrl','due','dueK'])
        // v817: 種類に idea（アイデア）・対象（app）・依頼した人（reqBy）・Slackのリンク・期限（due・dueK）
        && request.resource.data.kind in ['bug','req','idea']
        && id == string(request.resource.data.no)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == fbName()
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      // オーナーは切り分け・コメントなど全部。書いた本人は「新着」のうちだけ内容を直せる（書いた人・日時は変えられない）
      allow update: if isOwnerAdmin()
        || (fbOk() && resource.data.authorUid == request.auth.uid && resource.data.status == 'new'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind','screen','title','did','got','want','editedAt','app','reqBy','slackUrl'])
            && request.resource.data.kind in ['bug','req','idea']);
      // v822: 間違えて書いた時は、書いた本人も「新着」のうちは消せる（オーナーはいつでも）。スクショ・やりとりを先に消してから本体
      allow delete: if isOwnerAdmin() || fbMineNew(id);
      match /imgs/{k} {
        allow read: if fbOk();
        allow create: if fbOk() && request.resource.data.byUid == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() < 700000;
        allow delete: if isOwnerAdmin() || fbMineNew(id);
      }
      // やりとり：誰が・いつ（サーバー時刻）を必ず残す。管理者の印・状態の記録はオーナーだけ
      match /notes/{nid} {
        allow read: if fbOk();
        allow create: if fbOk()
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.byName == fbName()
          && request.resource.data.at == request.time
          && (request.resource.data.get('admin', false) == false || isOwnerAdmin())
          && (request.resource.data.get('kind', 'note') == 'note' || isOwnerAdmin());
        allow delete: if isOwnerAdmin() || fbMineNew(id);
      }
    }
  }
}
